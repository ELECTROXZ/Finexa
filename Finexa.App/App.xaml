<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Finexa_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Finexa_App"
    xmlns:converters="using:Finexa_App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:DateFormatConverter x:Key="DateFormatConverter" />
            <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
            <converters:CurrencyFormatter x:Key="CurrencyFormatter" />
            <converters:NegativeCurrencyFormatter x:Key="NegativeCurrencyFormatter" />
            <converters:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter" />
            <converters:DecimalToDoubleConverter x:Key="DecimalToDoubleConverter" />
            <converters:PaymentStatusToBgConverter x:Key="PaymentStatusToBgConverter" />
            <converters:PaymentStatusToColorConverter x:Key="PaymentStatusToColorConverter" />
            <converters:BalanceColorConverter x:Key="BalanceColorConverter" />

            <!-- Fallback Brushes -->
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C53929" />
            <SolidColorBrush x:Key="SystemFillColorDangerBrush" Color="#C53929" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="FinexaBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="FinexaCardBrush" Color="#121212" />
                    <SolidColorBrush x:Key="FinexaBorderBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="FinexaTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FinexaAccentBrush" Color="#2196F3" />
                    <SolidColorBrush x:Key="FinexaListDividerBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF6B6B" />
                    <SolidColorBrush x:Key="SystemFillColorDangerBrush" Color="#FF6B6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FinexaBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FinexaCardBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="FinexaBorderBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="FinexaTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="FinexaAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="FinexaListDividerBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C53929" />
                    <SolidColorBrush x:Key="SystemFillColorDangerBrush" Color="#C53929" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
