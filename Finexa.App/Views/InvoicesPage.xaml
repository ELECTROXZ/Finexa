<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Finexa_App.Views.InvoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:entities="using:Finexa.Domain.Entities"
    xmlns:local="using:Finexa_App.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Filter bar -->
            <RowDefinition Height="Auto" /> <!-- Undo Deleted banner -->
            <RowDefinition Height="*" />    <!-- Content Area (Grid / Empty State) -->
            <RowDefinition Height="Auto" /> <!-- Footer / Pagination -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Padding="24,16,24,8">
            <TextBlock Text="Sales Invoices" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Manage customer billing, invoices, payments, and accounts receivables" FontSize="13" Opacity="0.6" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <!-- Actions -->
                    <Button Command="{x:Bind ViewModel.NewInvoiceCommand}" Style="{ThemeResource AccentButtonStyle}" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="New Invoice" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="EditBtn" Command="{x:Bind ViewModel.EditInvoiceCommand}" IsEnabled="{x:Bind local:InvoicesPage.IsInvoiceSelected(ViewModel.SelectedInvoice), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="Edit" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="DeleteBtn" Command="{x:Bind ViewModel.DeleteInvoiceCommand}" IsEnabled="{x:Bind local:InvoicesPage.IsInvoiceSelected(ViewModel.SelectedInvoice), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.DuplicateInvoiceCommand}" IsEnabled="{x:Bind local:InvoicesPage.IsInvoiceSelected(ViewModel.SelectedInvoice), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Duplicate" />
                        </StackPanel>
                    </Button>

                    <Button Click="AddPaymentButton_Click" IsEnabled="{x:Bind local:InvoicesPage.IsInvoiceSelected(ViewModel.SelectedInvoice), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                            <TextBlock Text="Add Payment" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <Button Command="{x:Bind ViewModel.LoadInvoicesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.PrintInvoiceCommand}" IsEnabled="{x:Bind local:InvoicesPage.IsInvoiceSelected(ViewModel.SelectedInvoice), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE749;" FontSize="14" />
                            <TextBlock Text="Print" />
                        </StackPanel>
                    </Button>

                    <DropDownButton Content="Export">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Export to PDF" Click="ExportPdf_Click" Icon="Document" IsEnabled="{x:Bind local:InvoicesPage.IsInvoiceSelected(ViewModel.SelectedInvoice), Mode=OneWay}" />
                                <MenuFlyoutItem Text="Export list to Excel" Click="ExportExcel_Click" Icon="List" />
                                <MenuFlyoutItem Text="Export list to CSV" Click="ExportCsv_Click" Icon="AllApps" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <!-- Trash Bin / View Deleted Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <CheckBox Content="View Trash (Deleted Invoices)" IsChecked="{x:Bind ViewModel.ShowTrash, Mode=TwoWay}" Click="ShowTrash_Click" />
                    <Button x:Name="RestoreBtn" Command="{x:Bind ViewModel.RestoreInvoiceCommand}" IsEnabled="{x:Bind local:InvoicesPage.IsInvoiceSelected(ViewModel.SelectedInvoice), Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowTrash, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                            <TextBlock Text="Restore" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Stretch">
                <!-- Search Box -->
                <TextBox PlaceholderText="Search number, customer, phone, GST, amount..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280" KeyDown="SearchBox_KeyDown" Header="Quick Search" />

                <!-- Payment Status Filter -->
                <ComboBox Header="Payment Status" SelectedValue="{x:Bind ViewModel.SelectedPaymentStatus, Mode=TwoWay}" SelectionChanged="Filter_Changed" Width="130">
                    <x:String>All</x:String>
                    <x:String>Paid</x:String>
                    <x:String>Unpaid</x:String>
                    <x:String>Partial</x:String>
                </ComboBox>

                <!-- Date Range Filter Type -->
                <ComboBox x:Name="DateFilterCombo" Header="Date Filter" SelectedValue="{x:Bind ViewModel.SelectedDateFilter, Mode=TwoWay}" SelectionChanged="DateFilter_Changed" Width="130">
                    <x:String>All</x:String>
                    <x:String>Today</x:String>
                    <x:String>Yesterday</x:String>
                    <x:String>This Week</x:String>
                    <x:String>This Month</x:String>
                    <x:String>This Year</x:String>
                    <x:String>Custom</x:String>
                </ComboBox>

                <!-- Custom Dates -->
                <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" VerticalAlignment="Bottom">
                    <CalendarDatePicker Header="Start Date" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" DateChanged="CustomDate_Changed" Width="130" />
                    <CalendarDatePicker Header="End Date" Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" DateChanged="CustomDate_Changed" Width="130" />
                </StackPanel>

                <!-- Customer Filter -->
                <ComboBox Header="Filter by Customer" ItemsSource="{x:Bind ViewModel.Parties}" SelectedItem="{x:Bind ViewModel.SelectedParty, Mode=TwoWay}" SelectionChanged="Filter_Changed" DisplayMemberPath="Name" Width="200" PlaceholderText="All Customers" />

                <!-- Clear Filters Button -->
                <Button Content="Clear All" Click="ClearFilters_Click" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </StackPanel>
        </Border>

        <!-- Undo deleted notification banner -->
        <InfoBar Grid.Row="3" x:Name="UndoInfoBar" Title="Invoice Deleted" Message="The invoice was moved to trash successfully." Severity="Success" IsOpen="False" Margin="24,12,24,0">
            <InfoBar.ActionButton>
                <Button Content="Undo" Command="{x:Bind ViewModel.UndoDeleteCommand}" Click="Undo_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Content Area -->
        <Grid Grid.Row="4" Padding="24">
            <!-- Loading Indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.ZIndex="10" />

            <!-- Empty State View -->
            <StackPanel x:Name="EmptyStateView" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon Glyph="&#xE9F9;" FontSize="72" Opacity="0.3" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                <TextBlock Text="No invoices yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Start billing your customers by creating your first sales invoice." FontSize="13" Opacity="0.6" HorizontalAlignment="Center" Margin="0,-8,0,0" />
                <Button Content="Create First Invoice" Command="{x:Bind ViewModel.NewInvoiceCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- DataGrid listing -->
            <controls:DataGrid x:Name="InvoicesGrid"
                               AutoGenerateColumns="False"
                               ItemsSource="{x:Bind ViewModel.Invoices, Mode=OneWay}"
                               SelectedItem="{x:Bind ViewModel.SelectedInvoice, Mode=TwoWay}"
                               GridLinesVisibility="Horizontal"
                               CanUserResizeColumns="True"
                               CanUserReorderColumns="True"
                               CanUserSortColumns="True"
                               IsReadOnly="True"
                               DoubleTapped="InvoicesGrid_DoubleTapped"
                               SelectionChanged="InvoicesGrid_SelectionChanged"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch">
                
                <controls:DataGrid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Edit Invoice" Click="ContextEdit_Click" Icon="Edit" />
                        <MenuFlyoutItem Text="Duplicate Invoice" Click="ContextDuplicate_Click" Icon="Copy" />
                        <MenuFlyoutItem Text="Record Customer Payment" Click="AddPaymentButton_Click" Icon="Contact" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Print Invoice Details" Click="ContextPrint_Click" Icon="Print" />
                        <MenuFlyoutItem Text="Save PDF Copy" Click="ExportPdf_Click" Icon="Document" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Move to Trash" Click="ContextDelete_Click" Icon="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </MenuFlyout>
                </controls:DataGrid.ContextFlyout>

                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Invoice Number" Binding="{Binding InvoiceNumber}" FontSize="12" FontWeight="SemiBold" Width="140" Tag="InvoiceNumber" />
                    <controls:DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate, Converter={StaticResource DateFormatConverter}}" Width="120" Tag="InvoiceDate" />
                    <controls:DataGridTextColumn Header="Customer Name" Binding="{Binding Party.Name}" Width="180" Tag="PartyName" />
                    <controls:DataGridTextColumn Header="GSTIN" Binding="{Binding Party.GSTIN}" Width="140" />
                    
                    <controls:DataGridTemplateColumn Header="Subtotal" Width="110">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="entities:Invoice">
                                <TextBlock Text="{x:Bind SubTotal, Converter={StaticResource CurrencyFormatter}}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Header="Tax (GST)" Width="110">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="entities:Invoice">
                                <TextBlock Text="{x:Bind TaxAmount, Converter={StaticResource CurrencyFormatter}}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Header="Grand Total" Width="120" Tag="GrandTotal">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="entities:Invoice">
                                <TextBlock Text="{x:Bind TotalAmount, Converter={StaticResource CurrencyFormatter}}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Header="Payment Status" Width="130" Tag="PaymentStatus">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="entities:Invoice">
                                <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{x:Bind PaymentStatus, Converter={StaticResource PaymentStatusToBgConverter}}"
                                        BorderBrush="{x:Bind PaymentStatus, Converter={StaticResource PaymentStatusToColorConverter}}"
                                        BorderThickness="1">
                                    <TextBlock Text="{x:Bind PaymentStatus}" Foreground="{x:Bind PaymentStatus, Converter={StaticResource PaymentStatusToColorConverter}}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="130" />
                    <controls:DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="100" />
                    <controls:DataGridTextColumn Header="Last Modified" Binding="{Binding UpdatedAt, Converter={StaticResource DateTimeFormatConverter}}" Width="140" Tag="LastModified" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <!-- Footer / Pagination -->
        <Border Grid.Row="5" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Page Size selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Show:" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                    <ComboBox SelectedValue="{x:Bind ViewModel.PageSize, Mode=TwoWay}" SelectionChanged="PageSize_Changed" Width="80">
                        <x:Int32>10</x:Int32>
                        <x:Int32>25</x:Int32>
                        <x:Int32>50</x:Int32>
                        <x:Int32>100</x:Int32>
                    </ComboBox>
                </StackPanel>

                <!-- Page Number info -->
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PageDisplay, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />

                <!-- Pagination Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.PreviousPageCommand}" IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Payment Dialogue Modal -->
        <ContentDialog x:Name="PaymentDialog" Title="Record Customer Receipt" PrimaryButtonText="Record Payment" CloseButtonText="Cancel" PrimaryButtonClick="PaymentDialog_PrimaryButtonClick">
            <StackPanel Spacing="16" Width="360">
                <TextBlock Text="Record payment inflows from client towards this specific invoice details." FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                <NumberBox x:Name="PaymentAmountBox" Header="Receipt Amount (INR)" Value="0.00" SpinButtonPlacementMode="Compact" SmallChange="10" LargeChange="100" />
                <ComboBox x:Name="PaymentMethodCombo" Header="Payment Mode" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <x:String>Cash</x:String>
                    <x:String>Bank</x:String>
                    <x:String>UPI</x:String>
                    <x:String>Card</x:String>
                    <x:String>Cheque</x:String>
                </ComboBox>
                <TextBox x:Name="PaymentRefBox" Header="Transaction/Reference Number (Optional)" PlaceholderText="UTR, Txn ID or Cheque No" />
                <TextBox x:Name="PaymentNotesBox" Header="Payment Notes" PlaceholderText="Internal memo or details" TextWrapping="Wrap" Height="60" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
