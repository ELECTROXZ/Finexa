<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Finexa_App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar Navigation Menu -->
        <NavigationView x:Name="NavigationMenu"
                        Grid.Row="0"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="NavigationMenu_SelectionChanged">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" />
                
                <NavigationViewItemSeparator />
                
                <NavigationViewItemHeader Content="Core Modules" />
                <NavigationViewItem Content="Sales Invoices" Tag="sales" Icon="Document" />
                <NavigationViewItem Content="Purchase Bills" Tag="purchases" Icon="Shop" />
                <NavigationViewItem Content="Parties (Contacts)" Tag="parties" Icon="People" />
                <NavigationViewItem Content="Inventory Stock" Tag="inventory" Icon="List" />
                <NavigationViewItem Content="Expenses" Tag="expenses" Icon="Download" />
                <NavigationViewItem Content="Payments" Tag="payments" Icon="Target" />
                <NavigationViewItem Content="General Ledger" Tag="ledger" Icon="Library" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Spacing="8" Padding="12">
                    <!-- User Profile Card -->
                    <Grid Padding="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture Grid.Column="0" Width="36" Height="36" DisplayName="{x:Bind ViewModel.UserFullName, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.UserFullName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.UserRole, Mode=OneWay}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </Grid>
                    
                    <NavigationViewItemSeparator />

                    <!-- Quick Actions -->
                    <NavigationViewItem Content="Switch Theme" Tag="theme">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    
                    <NavigationViewItem Content="Log Out" Tag="logout">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- Navigation Frame Content -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- bottom Status Bar -->
        <Border Grid.Row="1" 
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Finexa ERP v1.0.0" FontSize="11" Opacity="0.7" />
                    <TextBlock Text="|" FontSize="11" Opacity="0.3" />
                    <TextBlock Text="Server Connection: Local SQL Server (Direct)" FontSize="11" Opacity="0.7" />
                </StackPanel>

                <TextBlock x:Name="SystemTimeTextBlock"
                           Grid.Column="1" 
                           FontSize="11" 
                           Opacity="0.7" />
            </Grid>
        </Border>
    </Grid>
</Page>
