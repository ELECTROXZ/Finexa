<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Finexa_App.Views.PartyProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:entities="using:Finexa.Domain.Entities"
    xmlns:local="using:Finexa_App.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header / Details summary bar -->
            <RowDefinition Height="*" />    <!-- Pivot view -->
        </Grid.RowDefinitions>

        <!-- Header Summary Bar -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Profile icon/initials -->
                <Ellipse Grid.Column="0" Width="64" Height="64" Fill="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Wait! Since we don't have profile image rendering in ellipse, initials text is clean and professional -->
                </Ellipse>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PartyInitials, Mode=OneWay}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,16,0" IsHitTestVisible="False" />

                <!-- Titles & Badges -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Party.Name, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                        <!-- Status Badge -->
                        <Border Background="{x:Bind ViewModel.StatusBgBrush, Mode=OneWay}" CornerRadius="12" Padding="12,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Party.Status, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.StatusColorBrush, Mode=OneWay}" />
                        </Border>
                        <!-- Type Badge -->
                        <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="12" Padding="12,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Party.Type, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16" Opacity="0.7">
                        <TextBlock Text="{x:Bind ViewModel.Party.Code, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="|" />
                        <TextBlock Text="{x:Bind ViewModel.Party.ContactPerson, Mode=OneWay}" FontSize="13" />
                        <TextBlock Text="|" />
                        <TextBlock Text="{x:Bind ViewModel.Party.Phone, Mode=OneWay}" FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="EditDetails_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="Edit Profile" />
                        </StackPanel>
                    </Button>
                    <Button Click="Back_Click" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Back to Directory" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pivot Tabs -->
        <Pivot Grid.Row="1" Padding="24,8">
            <!-- Pivot 1: General Profile details -->
            <PivotItem Header="Profile Summary">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Padding="0,16" ColumnSpacing="24" RowSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Profile info cards -->
                        <StackPanel Grid.Column="0" Spacing="16">
                            <!-- Basic details card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Contact Details" FontSize="16" FontWeight="SemiBold" />
                                    <MenuFlyoutSeparator />
                                    
                                    <Grid RowSpacing="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Company Display" Opacity="0.7" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Party.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Primary Contact" Opacity="0.7" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Party.ContactPerson, Mode=OneWay}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mobile Phone" Opacity="0.7" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Party.Phone, Mode=OneWay}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Alternative Phone" Opacity="0.7" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Party.AlternativePhone, Mode=OneWay}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Email / Web" Opacity="0.7" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{x:Bind ViewModel.Party.Email, Mode=OneWay}" />
                                            <TextBlock Text="-" />
                                            <TextBlock Text="{x:Bind ViewModel.Party.Website, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Taxation Details card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Taxation &amp; Registrations" FontSize="16" FontWeight="SemiBold" />
                                    <MenuFlyoutSeparator />

                                    <Grid RowSpacing="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GSTIN / GST Number" Opacity="0.7" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Party.GSTIN, Mode=OneWay}" FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PAN Number" Opacity="0.7" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Party.PAN, Mode=OneWay}" FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Aadhaar" Opacity="0.7" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Party.Aadhaar, Mode=OneWay}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Registration Number" Opacity="0.7" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Party.BusinessRegistrationNumber, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Panel: Financial info summary card -->
                        <StackPanel Grid.Column="1" Spacing="16">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Financial Setup" FontSize="16" FontWeight="SemiBold" />
                                    <MenuFlyoutSeparator />

                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Current Outstanding Balance" FontSize="12" Opacity="0.7" />
                                        <TextBlock Text="{x:Bind ViewModel.Party.OutstandingAmount, Mode=OneWay, Converter={StaticResource CurrencyFormatter}}" 
                                                   FontSize="28" 
                                                   FontWeight="Bold" 
                                                   Foreground="{x:Bind ViewModel.OutstandingBalanceColorBrush, Mode=OneWay}" />

                                        <Grid RowSpacing="8" ColumnSpacing="8" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Opening Balance" Opacity="0.7" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Party.OpeningBalance, Mode=OneWay, Converter={StaticResource CurrencyFormatter}}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Credit Limit" Opacity="0.7" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PartyCreditLimitDisplay, Mode=OneWay}" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Payment Terms" Opacity="0.7" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Party.PaymentTerms, Mode=OneWay}" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Preferred Method" Opacity="0.7" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Party.PreferredPaymentMethod, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Internal Remarks card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Remarks / Notes" FontSize="16" FontWeight="SemiBold" />
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Height="1" />
                                    <TextBlock Text="{x:Bind ViewModel.PartyNotes, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
                                    <TextBlock Text="No remarks added." FontStyle="Italic" Opacity="0.5" Visibility="{x:Bind ViewModel.IsNotesEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </PivotItem>

            <!-- Pivot 2: Addresses list -->
            <PivotItem Header="Addresses">
                <Grid Padding="0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Click="AddAddress_Click" Style="{ThemeResource AccentButtonStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add Address" />
                        </StackPanel>
                    </Button>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Addresses, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:PartyAddress">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding AddressLine1}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Background="LightGreen" CornerRadius="4" Padding="6,1" Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Primary" FontSize="10" Foreground="Black" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AddressLine2}" Opacity="0.8" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding City}" Opacity="0.8" />
                                                <TextBlock Text="," Margin="0,0,2,0" Opacity="0.8" />
                                                <TextBlock Text="{Binding State}" Opacity="0.8" />
                                                <TextBlock Text=" - " Opacity="0.8" />
                                                <TextBlock Text="{Binding Pincode}" Opacity="0.8" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Country}" Opacity="0.6" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="DeleteAddress_Click" Background="Transparent" BorderThickness="0" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="Red" FontSize="16" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- Pivot 3: Additional Contacts -->
            <PivotItem Header="Contacts">
                <Grid Padding="0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Click="AddContact_Click" Style="{ThemeResource AccentButtonStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add Contact Person" />
                        </StackPanel>
                    </Button>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Contacts, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:PartyContact">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Designation}" Opacity="0.6" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Phone}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Email}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button Grid.Column="1" Click="DeleteContact_Click" Background="Transparent" BorderThickness="0" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="Red" FontSize="16" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- Pivot 4: Ledger Summary & Transactions -->
            <PivotItem Header="Ledger &amp; Ledger Transactions">
                <Grid Padding="0,16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Action Toolbar -->
                        <RowDefinition Height="*" />    <!-- Transaction list DataGrid -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                        <Button Click="AddAdjustment_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Record Manual Adjustment" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <controls:DataGrid Grid.Row="1" 
                                       ItemsSource="{x:Bind ViewModel.Transactions, Mode=OneWay}"
                                       AutoGenerateColumns="False"
                                       GridLinesVisibility="Horizontal"
                                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                       BorderThickness="1"
                                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                       CornerRadius="6"
                                       HeadersVisibility="Column"
                                       IsReadOnly="True">
                        <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Date" Binding="{Binding Date, Converter={StaticResource DateFormatConverter}}" Width="120" />
                            <controls:DataGridTextColumn Header="Reference Type" Binding="{Binding ReferenceType}" Width="150" />
                            <controls:DataGridTextColumn Header="Reference Number" Binding="{Binding ReferenceNumber}" Width="150" />
                            <controls:DataGridTextColumn Header="Transaction Type" Binding="{Binding TransactionType}" Width="130" />
                            <controls:DataGridTemplateColumn Header="Amount" Width="150">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="entities:PartyTransaction">
                                        <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyFormatter}}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0,0,16,0" />
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="120" />
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </Grid>
            </PivotItem>

            <!-- Pivot 5: Attachments Documents -->
            <PivotItem Header="Attachments">
                <Grid Padding="0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Click="AddAttachment_Click" Style="{ThemeResource AccentButtonStyle}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                            <TextBlock Text="Upload File" />
                        </StackPanel>
                    </Button>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="entities:PartyDocument">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding FilePath}" Opacity="0.5" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding UploadedAt, Converter={StaticResource DateFormatConverter}}" Margin="0,0,16,0" VerticalAlignment="Center" Opacity="0.7" />
                                        <Button Grid.Column="3" Click="DeleteAttachment_Click" Background="Transparent" BorderThickness="0" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="Red" FontSize="16" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- Pivot 6: Activity logs Timeline -->
            <PivotItem Header="Timeline &amp; Audit Logs">
                <ListView ItemsSource="{x:Bind ViewModel.ActivityLogs, Mode=OneWay}" SelectionMode="None" Margin="0,16">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="entities:PartyActivityLog">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, Converter={StaticResource DateFormatConverter}}" Opacity="0.6" VerticalAlignment="Top" />
                                
                                <Ellipse Grid.Column="1" Width="12" Height="12" Fill="{ThemeResource SystemControlHighlightAccentBrush}" Margin="8,4,20,0" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                                        <TextBlock Text="by" Opacity="0.6" />
                                        <TextBlock Text="{Binding ChangedBy}" FontWeight="SemiBold" Opacity="0.8" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Opacity="0.8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>

        <!-- Address Add Dialog Details -->
        <ContentDialog x:Name="AddressDialog" Title="Add Additional Address" PrimaryButtonText="Save" CloseButtonText="Cancel" PrimaryButtonClick="AddressDialog_PrimaryButtonClick">
            <Grid Padding="0,12" RowSpacing="12" Width="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" x:Name="DlgAddr1" Header="Address Line 1 *" PlaceholderText="Street name, suite, office" MaxLength="200" />
                <TextBox Grid.Row="1" x:Name="DlgAddr2" Header="Address Line 2" PlaceholderText="Locality, area" MaxLength="200" />
                <TextBox Grid.Row="2" x:Name="DlgCity" Header="City *" PlaceholderText="City" MaxLength="50" />
                <TextBox Grid.Row="3" x:Name="DlgState" Header="State *" PlaceholderText="State" MaxLength="50" />
                <Grid Grid.Row="4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="DlgPin" Header="Pincode *" PlaceholderText="PIN" InputScope="Numeric" MaxLength="10" />
                    <CheckBox Grid.Column="1" x:Name="DlgPrimary" Content="Mark Primary" Margin="0,24,0,0" />
                </Grid>
            </Grid>
        </ContentDialog>

        <!-- Contact Add Dialog Details -->
        <ContentDialog x:Name="ContactDialog" Title="Add Contact Person" PrimaryButtonText="Save" CloseButtonText="Cancel" PrimaryButtonClick="ContactDialog_PrimaryButtonClick">
            <Grid Padding="0,12" RowSpacing="12" Width="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" x:Name="DlgContactName" Header="Full Name *" PlaceholderText="Contact person full name" MaxLength="100" />
                <TextBox Grid.Row="1" x:Name="DlgContactPhone" Header="Phone Number *" PlaceholderText="Mobile phone" MaxLength="15" />
                <TextBox Grid.Row="2" x:Name="DlgContactEmail" Header="Email Address" PlaceholderText="Email" MaxLength="100" />
                <TextBox Grid.Row="3" x:Name="DlgContactDesig" Header="Designation" PlaceholderText="Manager, Director, Accountant" MaxLength="50" />
            </Grid>
        </ContentDialog>

        <!-- Adjustment Add Dialog Details -->
        <ContentDialog x:Name="AdjustmentDialog" Title="Record Ledger Adjustment" PrimaryButtonText="Save" CloseButtonText="Cancel" PrimaryButtonClick="AdjustmentDialog_PrimaryButtonClick">
            <Grid Padding="0,12" RowSpacing="12" Width="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox Grid.Row="0" x:Name="DlgAdjType" Header="Adjustment Mode" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Debit (Increases receivables / decreases payables)" IsSelected="True" />
                    <ComboBoxItem Content="Credit (Decreases receivables / increases payables)" />
                </ComboBox>
                <NumberBox Grid.Row="1" x:Name="DlgAdjAmount" Header="Amount (₹) *" Value="0.00" SmallChange="10" LargeChange="100" />
                <TextBox Grid.Row="2" x:Name="DlgAdjRef" Header="Reference / Voucher Number *" PlaceholderText="ADJ-0001" MaxLength="50" />
                <TextBox Grid.Row="3" x:Name="DlgAdjNotes" Header="Remarks" PlaceholderText="Reason for manual adjustment..." MaxLength="200" />
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
