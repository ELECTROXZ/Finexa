<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Finexa_App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
            <TextBlock x:Name="TitleText" Text="Module Coming Soon" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="DescriptionText" Text="This section is currently under construction and will be fully integrated in the next phase of development." FontSize="14" Opacity="0.7" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
